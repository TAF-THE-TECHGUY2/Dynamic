APP_NAME="Dynamic Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA
APP_TIMEZONE=Africa/Johannesburg

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dynamic_solutions
DB_USERNAME=dynamic
DB_PASSWORD=dynamic

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Mail — AWS SES in production. Use `log` locally.
# Request SES production access on day one: the sandbox only delivers to
# verified addresses and approval takes a day or two.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="TODO@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AWS — SES (mail) and S3 (issued PDFs). Never make the bucket public.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# `s3` in production so issued PDFs land in the bucket. `local` for development.
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# spatie/laravel-pdf — Browsershot driver, headless Chromium.
# Leave blank to use Browsershot's auto-detection. On Forge, set
# LARAVEL_PDF_CHROME_PATH to the puppeteer-installed Chrome — see DEPLOY.md.
# ---------------------------------------------------------------------------
LARAVEL_PDF_DRIVER=browsershot
LARAVEL_PDF_CHROME_PATH=
LARAVEL_PDF_NODE_BINARY=
LARAVEL_PDF_NPM_BINARY=
LARAVEL_PDF_NO_SANDBOX=false

# ---------------------------------------------------------------------------
# Business facts. These are printed on quotes and invoices in front of
# customers — every TODO below must be filled in before going live.
# The seeded `settings` table is the runtime source of truth; these values
# only seed it on first run (see database/seeders/SettingSeeder.php).
# ---------------------------------------------------------------------------
BUSINESS_TRADING_NAME="Dynamic Solutions"
BUSINESS_REGISTERED_NAME="TODO — REGISTERED NAME (PTY) LTD"
BUSINESS_REG_NUMBER="TODO — 20XX/XXXXXX/07"
# Leave BUSINESS_VAT_NUMBER blank if not VAT registered. Blank forces every
# document to VAT mode `none` and hides VAT rows entirely (SARS requirement).
BUSINESS_VAT_NUMBER=
BUSINESS_EMAIL="TODO@example.com"
BUSINESS_PHONE="061 687 4334"
BUSINESS_WHATSAPP=27616874334
BUSINESS_ADDRESS_LINE1="31 Dassie Road"
BUSINESS_ADDRESS_LINE2="Zesfontein, Benoni"
BUSINESS_ADDRESS_LINE3="Gauteng, South Africa"
BUSINESS_HOURS_WEEKDAY="TODO — Mon–Fri hours"
BUSINESS_HOURS_SATURDAY="TODO — Saturday hours"
BUSINESS_HOURS_NOTE="After-hours by arrangement"

BUSINESS_BANK_NAME="TODO — bank"
BUSINESS_BANK_ACCOUNT_NAME="TODO — account name"
BUSINESS_BANK_ACCOUNT_NUMBER="TODO — account number"
BUSINESS_BANK_BRANCH_CODE="TODO — branch code"
BUSINESS_BANK_ACCOUNT_TYPE="TODO — account type"

# TODO — set the actual usable parking-bay count before launch. Zero keeps the
# missing fact visible in Admin → Settings instead of inventing capacity.
BUSINESS_YARD_BAYS=0

# ---------------------------------------------------------------------------
# Seeded owner account. Change the password immediately after first login.
# ---------------------------------------------------------------------------
OWNER_NAME="Tafara Siziba"
OWNER_EMAIL="TODO@example.com"
OWNER_PASSWORD="TODO — strong password, change after first login"

VITE_APP_NAME="${APP_NAME}"
